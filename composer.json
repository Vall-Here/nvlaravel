{
    "name": "vall-here/nvlaravel",
    "description": "Composable, enterprise-grade project scaffolding CLI for Laravel applications.",
    "keywords": ["laravel", "scaffold", "generator", "cli", "blade", "livewire", "inertia", "react", "vue", "htmx", "tailwind"],
    "homepage": "https://github.com/Vall-Here/nvlaravel",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/Vall-Here/nvlaravel/issues",
        "source": "https://github.com/Vall-Here/nvlaravel"
    },
    "require": {
        "php": "^8.2",
        "laravel-zero/framework": "^12.0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["nvlaravel"]
}
